<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <!--
      Owner passcode for the staff area (/Admin/Unlock) as a PBKDF2-SHA256
      hash (100,000 iterations) — never stored in plain text. See README
      "Security" for the default demo passcode and how to change it.
    -->
    <add key="AdminPasscodeHash" value="PBKDF2|100000|bee76638e3294258246fa47bbebdb267|CXtOxZom4EBUKbder31Lrqteqi+CsBOXkhoixkCMOeU=" />
  </appSettings>
  <connectionStrings>
    <!--
      Initial Catalog (no AttachDbFilename): the BrewHaven database lives
      inside the (localdb)\MSSQLLocalDB instance instead of being attached
      from App_Data. This avoids "Cannot attach the file ... as database
      'BrewHaven'" errors that happen when the same database name was
      already attached from a different project folder. Stale databases are
      dropped and reseeded automatically by BrewHavenDbInitializer.
    -->
    <add name="BrewHavenContext"
         connectionString="Data Source=(LocalDb)\MSSQLLocalDB;Initial Catalog=BrewHaven;Integrated Security=True;MultipleActiveResultSets=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <machineKey validationKey="b43642cedc5c0c4c961d3af60b216e58ad90adb513ff98a3ee5765ddc48f9270c5a18fe60d4ce79d50e4d65a504f69b473475910f11c2efd2ad2f34350df0ba6" decryptionKey="3a22f5578446d43a937e8f39493030f530a19dfcbcbac000201e4c105c8aa3b6" validation="HMACSHA256" decryption="AES" />
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="10485760" />
    <!--
      Source files (views, controllers, CSS) contain UTF-8 typographic
      characters (em dashes, curly quotes). fileEncoding makes ASP.NET read
      every file as UTF-8 even without a BOM, so browsers never see
      Windows-1252 mojibake like "â€".
    -->
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <authentication mode="None" />
    <!--
      Friendly branded error pages for real visitors (see ErrorController +
      Views/Shared/Error.cshtml and NotFound.cshtml). "RemoteOnly" keeps that
      protection for deployed servers while localhost (Visual Studio) shows
      the detailed yellow error page — so bugs surface with their exact
      exception and line number during development.
    -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error">
      <error statusCode="404" redirect="~/Error/NotFound" />
    </customErrors>
    <!-- Cart/session cookies are HttpOnly: JavaScript can never read them. -->
    <httpCookies httpOnlyCookies="true" />
    <!-- Idle sessions (cart + staff unlock) expire after 20 minutes. -->
    <sessionState timeout="20" />
  </system.web>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework" />
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
  <system.webServer>
    <modules>
      <remove name="FormsAuthentication" />
    </modules>
    <!-- Security headers on every response. -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>
    <httpCompression>
      <dynamicTypes>
        <add mimeType="text/*" enabled="true" />
        <add mimeType="message/*" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="*/*" enabled="false" />
      </dynamicTypes>
      <staticTypes>
        <add mimeType="text/*" enabled="true" />
        <add mimeType="message/*" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="*/*" enabled="false" />
      </staticTypes>
    </httpCompression>
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="Default.htm" />
        <add value="index.html" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
