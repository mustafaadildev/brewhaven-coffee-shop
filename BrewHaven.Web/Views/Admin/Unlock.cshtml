@{
    ViewBag.Title = "Staff access";
}

<section class="page-hero page-hero-slim">
    <div class="container">
        <p class="eyebrow eyebrow-light">Brew Haven · staff</p>
        <h1>Staff access</h1>
        <p class="page-hero-lede">This area is for the owner. Enter the staff passcode to manage the menu and orders.</p>
    </div>
</section>

<div class="section cart-body">
    <div class="container admin-unlock-wrap">
        <div class="cart-card admin-unlock-card">
            <h2>Unlock the staff area</h2>
            @Html.ValidationSummary(true)
            @using (Html.BeginForm("Unlock", "Admin", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.TextBox("passcode", null, new
                {
                    type = "password",
                    placeholder = "Staff passcode",
                    autocomplete = "off",
                    maxlength = "64",
                    @class = "unlock-input"
                })
                <button type="submit" class="btn btn-solid">Unlock</button>
            }
            <p class="unlock-note">Closing the browser locks it again automatically. Five wrong attempts lock the form for 15 minutes. The demo passcode lives in the project README.</p>
        </div>
    </div>
</div>
