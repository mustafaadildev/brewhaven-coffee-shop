@model BrewHaven.Web.Models.ContactForm
@{
    ViewBag.Title = "Contact";
    var topics = new SelectList(new[]
    {
        "General question",
        "Catering & events",
        "Private hire — corner booth",
        "Feedback",
        "Wholesale beans",
        "Working with us"
    });
}

<section class="page-hero">
    <div class="container">
        <p class="eyebrow eyebrow-light">Contact</p>
        <h1>Find us, call us, or just come say hi</h1>
        <p class="page-hero-lede">We answer email within one business day — usually with our right hand while holding a cupping spoon in our left.</p>
    </div>
</section>

<section class="section">
    <div class="container contact-grid">
        <div class="contact-info">
            <div class="info-card">
                <span class="info-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 1 7 7c0 5-7 13-7 13S5 14 5 9a7 7 0 0 1 7-7z" fill="none" stroke="currentColor" stroke-width="1.7"></path><circle cx="12" cy="9" r="2.6" fill="none" stroke="currentColor" stroke-width="1.7"></circle></svg></span>
                <h3>Visit</h3>
                <p>214 Willow Lane, Riverbend<br />Portland, OR 97209</p>
                <p class="info-note">Two blocks off the green line. Bike racks out front, street parking after 10am.</p>
            </div>
            <div class="info-card">
                <span class="info-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path></svg></span>
                <h3>Call</h3>
                <p><a href="tel:+15035550147">(503) 555-0147</a></p>
                <p class="info-note">Ring before 8am and the baker will probably answer — order ahead and skip the queue.</p>
            </div>
            <div class="info-card">
                <span class="info-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.7"></rect><path d="M3 7l9 6 9-6" fill="none" stroke="currentColor" stroke-width="1.7"></path></svg></span>
                <h3>Write</h3>
                <p><a href="mailto:hello&#64;brewhaven.coffee">hello&#64;brewhaven.coffee</a></p>
                <p class="info-note">Wholesale and catering quotes usually go out the same day.</p>
            </div>
            <div class="info-card">
                <span class="info-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.7"></circle><path d="M12 7v5l3.5 2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg></span>
                <h3>Hours</h3>
                <ul class="hours-list">
                    <li><span>Mon – Fri</span><span>7:00 – 18:00</span></li>
                    <li><span>Saturday</span><span>8:00 – 18:00</span></li>
                    <li><span>Sunday</span><span>8:00 – 16:00</span></li>
                </ul>
            </div>
        </div>

        <div class="contact-form-card">
            <h2>Send us a note</h2>
            <p class="section-sub">Booking the corner booth, ordering a pastry board, or telling us the playlist was too loud — this form reaches all of us.</p>

            @if (ViewBag.Sent != null && (bool)ViewBag.Sent)
            {
                <div class="form-success" role="status">
                    <strong>Thanks — your note is on the corkboard.</strong>
                    <p>We usually reply within one business day. If it's urgent, call (503) 555-0147.</p>
                </div>
            }

            @using (Html.BeginForm("Contact", "Home", FormMethod.Post, new { @class = "contact-form" }))
            {
                @Html.AntiForgeryToken()
                <div class="field-row">
                    <div class="field">
                        @Html.LabelFor(m => m.Name)
                        @Html.TextBoxFor(m => m.Name, new { @class = "input", placeholder = "Ada Marlowe", autocomplete = "name" })
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "field-error" })
                    </div>
                    <div class="field">
                        @Html.LabelFor(m => m.Email)
                        @Html.TextBoxFor(m => m.Email, new { @class = "input", placeholder = "you@example.com", autocomplete = "email", type = "email" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-error" })
                    </div>
                </div>
                <div class="field-row">
                    <div class="field">
                        @Html.LabelFor(m => m.Phone)
                        @Html.TextBoxFor(m => m.Phone, new { @class = "input", placeholder = "(503) 555-0000", autocomplete = "tel", type = "tel" })
                        @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "field-error" })
                    </div>
                    <div class="field">
                        @Html.LabelFor(m => m.Topic)
                        @Html.DropDownListFor(m => m.Topic, topics, new { @class = "input" })
                        @Html.ValidationMessageFor(m => m.Topic, "", new { @class = "field-error" })
                    </div>
                </div>
                <div class="field">
                    @Html.LabelFor(m => m.Message)
                    @Html.TextAreaFor(m => m.Message, 5, 40, new { @class = "input", placeholder = "Tell us what you need — dates, head count, beans per pound…" })
                    @Html.ValidationMessageFor(m => m.Message, "", new { @class = "field-error" })
                </div>
                <button class="btn btn-solid btn-lg" type="submit">Send message</button>
                <p class="form-note">Demo site: the form validates and posts through MVC, but nothing is stored yet — a database can be wired into the POST action later.</p>
            }
        </div>
    </div>
</section>

<section class="section section-cream map-section">
    <div class="container">
        <div class="hours-location">
            <div class="hl-info">
                <p class="eyebrow">Getting here</p>
                <h2>Two blocks off the green line</h2>
                <p class="hl-address"><strong>214 Willow Lane, Riverbend, Portland OR 97209</strong><br />Streetcar to Riverbend &amp; 3rd, then a two-minute walk toward the river. Bike parking right outside; the blue painted bike lane runs past the door.</p>
                <ul class="plain-list">
                    <li><strong>Streetcar:</strong> Riverbend &amp; 3rd stop</li>
                    <li><strong>Bus:</strong> 14 &amp; 33, "Willow &amp; 2nd"</li>
                    <li><strong>Parking:</strong> free 90-minute spots on Willow after 10am</li>
                </ul>
            </div>
            <div class="hl-map" role="img" aria-label="Stylized map showing Brew Haven at Willow Lane, near the Riverbend & 3rd streetcar stop">
                <div class="map-grid"></div>
                <div class="map-pin">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 1 7 7c0 5-7 13-7 13S5 14 5 9a7 7 0 0 1 7-7z" fill="#2b1d15"></path><circle cx="12" cy="9" r="2.6" fill="#c98a3d"></circle></svg>
                    <span class="map-pin-label">Brew Haven · 214 Willow Ln</span>
                </div>
            </div>
        </div>
    </div>
</section>
