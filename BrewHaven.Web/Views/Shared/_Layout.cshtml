@{
    var title = ViewBag.Title as string;
    var currentAction = (ViewContext.RouteData.Values["action"] ?? "Index").ToString();
    Func<string, string> navClass = a => "nav-link" + (a == currentAction ? " active" : "");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(string.IsNullOrEmpty(title) ? "Brew Haven · Coffee & Breakfast House" : title + " · Brew Haven")</title>
    <meta name="description" content="Brew Haven — a cozy neighborhood coffee shop in Portland serving small-batch espresso, pour overs and from-scratch breakfast." />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%232b1d15'/%3E%3Cpath d='M18 26h22v12a10 10 0 0 1-10 10h-2a10 10 0 0 1-10-10z' fill='%23c98a3d'/%3E%3Cpath d='M40 29h5a5 5 0 0 1 0 10h-5' fill='none' stroke='%23c98a3d' stroke-width='3'/%3E%3Cpath d='M24 18v4M32 18v4' stroke='%23c98a3d' stroke-width='3' stroke-linecap='round'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="~/Content/site.css" rel="stylesheet" />
</head>
<body class="@(string.Equals(ViewBag.Theme as string, "dark", StringComparison.OrdinalIgnoreCase) ? "theme-dark" : "")">
    <header class="site-header" id="siteHeader">
        <div class="container header-inner">
            <a class="brand" href="@Url.Action("Index", "Home")" aria-label="Brew Haven home">
                <svg class="brand-mark" viewBox="0 0 72 72" aria-hidden="true" focusable="false">
                    <circle cx="36" cy="36" r="34" fill="#2b1d15" stroke="#cf9445" stroke-width="2"></circle>
                    <circle cx="36" cy="36" r="29.5" fill="none" stroke="#cf9445" stroke-width="1" opacity="0.4"></circle>
                    <path class="steam s1" d="M29 27c-2.5-3 2.5-5.5 0-9" fill="none" stroke="#eccf9a" stroke-width="2.2" stroke-linecap="round"></path>
                    <path class="steam s2" d="M36 26c-2.5-3.5 2.5-6 0-10" fill="none" stroke="#eccf9a" stroke-width="2.2" stroke-linecap="round"></path>
                    <path class="steam s3" d="M43 27c-2.5-3 2.5-5.5 0-9" fill="none" stroke="#eccf9a" stroke-width="2.2" stroke-linecap="round"></path>
                    <path d="M25 33h22v6a11 11 0 0 1-11 11 11 11 0 0 1-11-11z" fill="#e2b56d"></path>
                    <path d="M47 35h4.5a5.5 5.5 0 0 1 0 11H47" fill="none" stroke="#e2b56d" stroke-width="2.6"></path>
                    <path d="M22 50.5h28" fill="none" stroke="#e2b56d" stroke-width="2.4" stroke-linecap="round"></path>
                </svg>
                <span class="brand-text">
                    <span class="brand-name">Brew Haven</span>
                    <span class="brand-sub">Coffee &amp; Breakfast House</span>
                </span>
            </a>
            <nav class="primary-nav" id="primaryNav" aria-label="Primary">
                @Html.ActionLink("Home", "Index", "Home", null, new { @class = navClass("Index") })
                @Html.ActionLink("Menu", "Menu", "Home", null, new { @class = navClass("Menu") })
                @Html.ActionLink("About", "About", "Home", null, new { @class = navClass("About") })
                @Html.ActionLink("Contact", "Contact", "Home", null, new { @class = navClass("Contact") })
                @Html.ActionLink("Your order", "Index", "Cart", null, new { @class = navClass("__none") + " nav-cart" })
            </nav>
            <a class="btn btn-solid btn-nav" href="@Url.Action("Menu", "Home")">Order now</a>
            <button class="nav-toggle" id="navToggle" type="button" aria-expanded="false" aria-controls="primaryNav" aria-label="Toggle navigation">
                <span></span><span></span><span></span>
            </button>
        </div>
    </header>

    <main id="main">
        @if (TempData["Flash"] != null)
        {
            <div class="flash-note" role="status">@TempData["Flash"]</div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-grid">
            <div class="footer-col footer-brand">
                <a class="brand brand-light" href="@Url.Action("Index", "Home")">
                    <svg class="brand-mark" viewBox="0 0 72 72" aria-hidden="true" focusable="false">
                        <circle cx="36" cy="36" r="34" fill="#c98a3d" stroke="#f3d9a4" stroke-width="2"></circle>
                        <circle cx="36" cy="36" r="29.5" fill="none" stroke="#f3d9a4" stroke-width="1" opacity="0.45"></circle>
                        <path class="steam s1" d="M29 27c-2.5-3 2.5-5.5 0-9" fill="none" stroke="#4a3018" stroke-width="2.2" stroke-linecap="round"></path>
                        <path class="steam s2" d="M36 26c-2.5-3.5 2.5-6 0-10" fill="none" stroke="#4a3018" stroke-width="2.2" stroke-linecap="round"></path>
                        <path class="steam s3" d="M43 27c-2.5-3 2.5-5.5 0-9" fill="none" stroke="#4a3018" stroke-width="2.2" stroke-linecap="round"></path>
                        <path d="M25 33h22v6a11 11 0 0 1-11 11 11 11 0 0 1-11-11z" fill="#2b1d15"></path>
                        <path d="M47 35h4.5a5.5 5.5 0 0 1 0 11H47" fill="none" stroke="#2b1d15" stroke-width="2.6"></path>
                        <path d="M22 50.5h28" fill="none" stroke="#2b1d15" stroke-width="2.4" stroke-linecap="round"></path>
                    </svg>
                    <span class="brand-text">
                        <span class="brand-name">Brew Haven</span>
                        <span class="brand-sub">Coffee &amp; Breakfast House</span>
                    </span>
                </a>
                <p>A corner coffee shop in Portland's Riverbend district. Small-batch roasts, breakfast from scratch, and a table that always feels like yours.</p>
                <div class="social-row">
                    <a href="https://instagram.com" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"></rect><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"></circle><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor"></circle></svg></a>
                    <a href="https://facebook.com" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8.5V7a1.5 1.5 0 0 1 1.5-1.5H17V3h-2.5A4 4 0 0 0 10.5 7v1.5H8V11h2.5v9h3.5v-9H16l.5-2.5z" fill="currentColor"></path></svg></a>
                    <a href="https://x.com" aria-label="X (Twitter)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4l7.1 9.3L4.4 20h2.6l5.3-5.4L16.5 20H20l-7.4-9.7L18.9 4h-2.6l-4.7 4.9L8 4z" fill="currentColor"></path></svg></a>
                </div>
            </div>
            <div class="footer-col">
                <h4>Explore</h4>
                <ul>
                    <li>@Html.ActionLink("Home", "Index", "Home")</li>
                    <li>@Html.ActionLink("Full menu", "Menu", "Home")</li>
                    <li>@Html.ActionLink("Your order", "Index", "Cart")</li>
                    <li>@Html.ActionLink("Our story", "About", "Home")</li>
                    <li>@Html.ActionLink("Contact & directions", "Contact", "Home")</li>
                </ul>
            </div>
            <div class="footer-col">
                <h4>Hours</h4>
                <ul class="hours-list">
                    <li><span>Mon – Fri</span><span>7:00 – 18:00</span></li>
                    <li><span>Saturday</span><span>8:00 – 18:00</span></li>
                    <li><span>Sunday</span><span>8:00 – 16:00</span></li>
                </ul>
                <p class="footer-note">Kitchen closes 30 minutes before we do.</p>
            </div>
            <div class="footer-col">
                <h4>Visit us</h4>
                <ul>
                    <li>214 Willow Lane, Riverbend<br />Portland, OR 97209</li>
                    <li><a href="tel:+15035550147">(503) 555-0147</a></li>
                    <li><a href="mailto:hello&#64;brewhaven.coffee">hello&#64;brewhaven.coffee</a></li>
                </ul>
            </div>
        </div>
        <div class="container footer-bottom">
            <p>© <span id="year">2025</span> Brew Haven Coffee &amp; Breakfast House. Brewed with patience in Portland, Oregon.</p>
        </div>
    </footer>

    <script src="~/Scripts/site.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
