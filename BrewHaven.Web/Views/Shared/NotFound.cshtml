@{
    ViewBag.Title = "Page not found";
}

<section class="page-hero page-hero-slim">
    <div class="container">
        <p class="eyebrow eyebrow-light">Brew Haven</p>
        <h1>404 — that page ran out</h1>
        <p class="page-hero-lede">The address you followed doesn't exist here. Maybe the menu moved, maybe the coffee was too strong.</p>
    </div>
</section>

<div class="section">
    <div class="container error-links">
        <a class="btn btn-solid" href="@Url.Action("Menu", "Home")">Browse the menu</a>
        <a class="btn btn-outline" href="@Url.Action("Index", "Home")">Back to home</a>
        <a class="btn btn-outline" href="@Url.Action("About", "Home")">Our story</a>
    </div>
</div>
